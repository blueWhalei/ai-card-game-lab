# ===== 应用配置 =====
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== OpenAI =====
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== DeepSeek =====
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 默认 deepseek-v4-flash；更强可选 deepseek-v4-pro（deepseek-chat / reasoner 已下架）
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== Kimi / Moonshot =====
KIMI_API_KEY=your-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ===== DashScope（阿里通义）=====
DASHSCOPE_API_KEY=your-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 智谱 AI（GLM）=====
ZHIPU_API_KEY=your-key-here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== MiniMax =====
MINIMAX_API_KEY=your-key-here
MINIMAX_BASE_URL=https://api.minimax.chat/v1/text/chatcompletion_v2

# ===== 零一万物（Yi）=====
YI_API_KEY=your-key-here
YI_BASE_URL=https://api.lingyiwanwu.com/v1

# ===== 百川智能 =====
BAICHUAN_API_KEY=your-key-here
BAICHUAN_BASE_URL=https://api.baichuan-ai.com/v1

# ===== Ollama（本地大模型）=====
OLLAMA_BASE_URL=http://localhost:11434

# ===== 训练 =====
# true=默认走 Mock（无需 GPU）；真实 LoRA：先 poetry install --with training，再设 false
TRAINING_USE_MOCK=true

# ===== Prompt 版本 / A/B（可选）=====
# PROMPT_VERSION=v1
# PROMPT_AB_TEST_ENABLED=false
# PROMPT_AB_TEST_RATIO=0.5
